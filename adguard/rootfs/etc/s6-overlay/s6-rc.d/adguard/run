#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: AdGuard Home
# Runs the AdGuard Home server
# ==============================================================================
declare -a options

bashio::log.info "Starting AdGuard Home server..."

options+=(--port 45158)
options+=(--host 127.0.0.1)
options+=(--work-dir /data/adguard)

if bashio::debug; then
  options+=(--verbose)
fi

# Run the persistent binary.  Do not add --no-check-update: this app exists so
# AdGuard Home can use its own beta-channel updater.
exec /data/adguard/AdGuardHome "${options[@]}"
